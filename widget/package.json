{
  "name": "sia-hmi-widget",
  "version": "1.0.0",
  "description": "Channel-native SIA HMI remote component for Doover.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "test": "node --experimental-strip-types --test src/lib/assembleDashboardData.test.ts",
    "typecheck": "tsc --noEmit",
    "watch": "rsbuild build --watch --mode development",
    "serve": "serve -s assets/ -l 8003"
  },
  "dependencies": {
    "@module-federation/enhanced": "^0.21.6",
    "@module-federation/rsbuild-plugin": "^0.21.6",
    "@rsbuild/core": "^1.6.14",
    "@rsbuild/plugin-react": "^1.4.2",
    "@rspack/cli": "^1.6.7",
    "@tanstack/react-query": "~5.90.2",
    "doover-js": "^0.6.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.7.0",
    "serve": "^14.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.8.3"
  }
}
